# ---------------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file. It is already in .gitignore.
# ---------------------------------------------------------------

# Discord bot token (Discord Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Your AI provider settings. Any provider works as long as it speaks
# one of the two supported request formats (see AI_API_FORMAT below).
AI_API_KEY=
# Full endpoint URL, e.g. https://your-provider.example/v1/chat/completions
AI_API_URL=
# Model name exactly as your provider expects it
AI_MODEL=

# Your Discord user ID. Add more admins with commas: 123,456
OWNER_ID=

# ---------------- Optional settings (defaults shown) ----------------

# Request format your provider uses:
#   chat_completions  -> body {model, messages:[{role,content}]}, reply in choices[0].message.content
#   messages          -> body {model, system, messages, max_tokens}, reply in content[].text
AI_API_FORMAT=chat_completions

# How the API key is sent. Most providers use "Authorization: Bearer <key>".
# Some use a custom header, e.g. AI_AUTH_HEADER=x-api-key and AI_AUTH_PREFIX= (empty)
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX=Bearer
# Extra headers as JSON if your provider needs them, e.g. {"some-version":"2024-01-01"}
AI_EXTRA_HEADERS=

AI_MAX_TOKENS=700
AI_TEMPERATURE=0.7

# Command prefix
PREFIX=!

# Let the bot decide what is worth remembering from the OWNER's messages
AUTO_MEMORY=true

# Access level given to auto-extracted memories: public | private | internal
AUTO_MEMORY_ACCESS=private

# Allow storing things that look sensitive (addresses, phone numbers, passwords...)
# Leave false unless you really know why you want it.
ALLOW_SENSITIVE_MEMORY=false

# How many recent messages per channel the bot keeps as short-term memory
SHORT_TERM_LIMIT=12
# Minutes of silence before a channel's short-term memory is cleared
SHORT_TERM_TTL_MINUTES=30

# Max number of long-term memories sent to the AI per question
MAX_CONTEXT_MEMORIES=8
