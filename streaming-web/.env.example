# ── Backend ────────────────────────────────────────────────────────────────
# Base URL of your existing API. All paths in src/lib/api/endpoints.ts are
# appended to this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# "bearer" stores the token returned by the login endpoint and sends it as
# Authorization: Bearer <token>. "cookie" relies on an httpOnly session cookie
# set by the backend and sends requests with credentials: "include".
NEXT_PUBLIC_AUTH_STRATEGY=bearer

# Header used to tell the backend which profile is active (multi-profile accounts).
NEXT_PUBLIC_PROFILE_HEADER=X-Profile-Id

# ── Development ────────────────────────────────────────────────────────────
# true = serve everything from src/mocks (no backend needed).
# Set to false once the endpoints are wired up.
NEXT_PUBLIC_USE_MOCKS=true

# ── Images ─────────────────────────────────────────────────────────────────
# Comma-separated hostnames that Next's image optimiser may fetch from.
# Add your media CDN here. picsum.photos is only used by the mock data.
NEXT_PUBLIC_IMAGE_HOSTS=picsum.photos,fastly.picsum.photos

# ── Brand ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Rumdul
